  "edges": [
    {
      "id": "dev-init",
      "from": "dev",
      "to": "init",
      "variant": "default"
    },
    {
      "id": "init-list",
      "from": "init",
      "to": "feature_list",
      "label": "declara",
      "variant": "emphasis"
    },
    {
      "id": "list-code",
      "from": "feature_list",
      "to": "code",
      "variant": "default"
    },
    {
      "id": "code-gate",
      "from": "code",
      "to": "gatekeeper",
      "label": "commit",
      "variant": "emphasis"
    },
    {
      "id": "gate-back",
      "from": "gatekeeper",
      "to": "feature_list",
      "label": "sem feature — declare",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "gate-test",
      "from": "gatekeeper",
      "to": "test",
      "label": "liberado",
      "variant": "emphasis"
    },
    {
      "id": "test-harness",
      "from": "test",
      "to": "harness_ok",
      "label": "pré-push",
      "variant": "default"
    },
    {
      "id": "harness-push",
      "from": "harness_ok",
      "to": "commit_push",
      "label": "OK",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Regras dos gates (Aulas 07-09)",
      "items": [
        "Uma feature in_progress por vez — escopo declarado antes de editar",
        "Nada de 'done' sem evidência: build, testes e validate-harness executados"
      ]
    },
    {
      "dot": "cyan",
      "title": "Ao concluir — artefatos de aprendizado",
      "items": [
        "feature-report (o que foi entregue) + feature-quiz (o que aprender)",
        "Diagrama Archify do fluxo/arquitetura da mudança — como este"
      ]
    },
    {
      "dot": "emerald",
      "title": "Achado do piloto G1",
      "items": [
        "O gatekeeper bloqueia até a atualização da própria feature_list",
        "Melhoria recomendada: permitir commits só-de-estado"
      ]
    }
  ]
}