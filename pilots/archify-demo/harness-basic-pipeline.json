    {
      "id": "gatekeeper",
      "lane": "system",
      "col": 3,
      "type": "security",
      "label": "Gatekeeper",
      "sublabel": "pre-commit",
      "tag": "bloqueia sem feature",
      "width": 132
    },
    {
      "id": "harness_ok",
      "lane": "dev",
      "col": 5,
      "type": "security",
      "label": "validate-harness",
      "sublabel": "HARNESS OK",
