      "label": "init.sh",
      "sublabel": "boot do harness",
      "width": 132
    },
    {
      "id": "feature_list",
      "lane": "dev",
      "col": 2,
      "type": "database",
      "label": "feature_list.json",
      "sublabel": "1 feature in_progress",
      "tag": "fonte de verdade",
      "width": 132
    },
    {
      "id": "code",
      "lane": "dev",
      "col": 3,
      "type": "frontend",
      "label": "Implementação",
