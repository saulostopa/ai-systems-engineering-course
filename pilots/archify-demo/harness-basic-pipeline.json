{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Harness Básico — pipeline de feature com gates",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "happy-path",
        "label": "Feature entregue com evidência",
        "focus": [
          "dev",
          "init",
          "feature_list",
          "code",
          "gatekeeper",
          "test",
          "harness_ok",
          "commit_push"
        ],
        "note": "O caminho feliz: declaração de escopo até a feature passing."
      },
      {
        "id": "gates",
        "label": "Gates mecânicos",
        "focus": [
          "gatekeeper",
          "harness_ok"
        ],
        "note": "Onde o harness bloqueia: sem feature in_progress, sem validação."
      }
    ],
    "output": "pilots/archify-demo/harness-basic-pipeline.html"
  },
  "lanes": [
    {
      "id": "dev",
      "label": "Desenvolvedor"
    },
    {
      "id": "system",
      "label": "Harness + Repositório"
    }
  ],
  "phases": [
    {
      "id": "boot",
      "label": "Boot",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "work",
      "label": "Implementação",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "close",
      "label": "Gates + encerramento",
      "fromCol": 4,
      "toCol": 5
    }
  ],
  "groups": [
    {
      "id": "gate_zone",
      "label": "Zona de gates",
      "lane": "system",
      "fromCol": 3,
      "toCol": 3,
      "variant": "security"
    }
  ],
  "mainPath": [
    "dev",
    "init",
    "feature_list",
    "code",
    "gatekeeper",
    "test",
    "harness_ok",
    "commit_push"
