{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Basic Harness — feature pipeline with gates",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "happy-path",
        "label": "Feature delivered with evidence",
        "focus": [
          "dev",
          "init",
          "feature_list",
          "code",
          "gatekeeper",
          "test",
          "harness_ok",
          "commit_push"
        ],
        "note": "The happy path: from scope declaration to a passing feature."
      },
      {
        "id": "gates",
        "label": "Mechanical gates",
        "focus": [
          "gatekeeper",
          "harness_ok"
        ],
        "note": "Where the harness blocks: no feature in_progress, no validation."
      }
    ],
    "output": "pilots/archify-demo/harness-basic-pipeline.html"
  },
  "lanes": [
    {
      "id": "dev",
      "label": "Developer"
    },
    {
      "id": "system",
      "label": "Harness + Repository"
    }
  ],
  "phases": [
    {
      "id": "boot",
      "label": "Boot",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "work",
      "label": "Implementation",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "close",
      "label": "Gates + closing",
      "fromCol": 4,
      "toCol": 5
    }
  ],
  "groups": [
    {
      "id": "gate_zone",
      "label": "Gate zone",
      "lane": "system",
      "fromCol": 3,
      "toCol": 3,
      "variant": "security"
    }
  ],
  "mainPath": [
    "dev",
    "init",
    "feature_list",
    "code",
    "gatekeeper",
    "test",
    "harness_ok",
    "commit_push"
  ],
  "nodes": [
    {
      "id": "dev",
      "lane": "dev",
      "col": 0,
      "type": "external",
      "label": "Person or Agent",
      "sublabel": "requests the feature",
      "width": 132
    },
    {
      "id": "init",
      "lane": "dev",
      "col": 1,
      "type": "frontend",
      "label": "init.sh",
      "sublabel": "harness boot",
      "width": 132
    },
    {
      "id": "feature_list",
      "lane": "dev",
      "col": 2,
      "type": "database",
      "label": "feature_list.json",
      "sublabel": "1 feature in_progress",
      "tag": "source of truth",
      "width": 132
    },
    {
      "id": "code",
      "lane": "dev",
      "col": 3,
      "type": "frontend",
      "label": "Implementation",
      "sublabel": "declared scope",
      "width": 132
    },
    {
      "id": "test",
      "lane": "dev",
      "col": 4,
      "type": "backend",
      "label": "Build + Tests",
      "sublabel": "evidence attached",
      "width": 132
    },
    {
      "id": "gatekeeper",
      "lane": "system",
      "col": 3,
      "type": "security",
      "label": "Gatekeeper",
      "sublabel": "pre-commit",
      "tag": "blocks without a feature",
      "width": 132
    },
    {
      "id": "harness_ok",
      "lane": "dev",
      "col": 5,
      "type": "security",
      "label": "validate-harness",
      "sublabel": "HARNESS OK",
      "tag": "pre-push",
      "width": 132
    },
    {
      "id": "commit_push",
      "lane": "system",
      "col": 5,
      "type": "cloud",
      "label": "Commit + Push",
      "sublabel": "feature passing — report + quiz generated",
      "width": 170
    }
  ],
  "edges": [
    {
      "id": "dev-init",
      "from": "dev",
      "to": "init",
      "variant": "default"
    },
    {
      "id": "init-list",
      "from": "init",
      "to": "feature_list",
      "label": "declares",
      "variant": "emphasis"
    },
    {
      "id": "list-code",
      "from": "feature_list",
      "to": "code",
      "variant": "default"
    },
    {
      "id": "code-gate",
      "from": "code",
      "to": "gatekeeper",
      "label": "commit",
      "variant": "emphasis"
    },
    {
      "id": "gate-back",
      "from": "gatekeeper",
      "to": "feature_list",
      "label": "no feature — declare it",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "gate-test",
      "from": "gatekeeper",
      "to": "test",
      "label": "released",
      "variant": "emphasis"
    },
    {
      "id": "test-harness",
      "from": "test",
      "to": "harness_ok",
      "label": "pre-push",
      "variant": "default"
    },
    {
      "id": "harness-push",
      "from": "harness_ok",
      "to": "commit_push",
      "label": "OK",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Gate rules (Lessons 07-09)",
      "items": [
        "One feature in_progress at a time — scope declared before editing",
        "No 'done' without evidence: build, tests and validate-harness executed"
      ]
    },
    {
      "dot": "cyan",
      "title": "When done — learning artifacts",
      "items": [
        "feature-report (what was delivered) + feature-quiz (what to learn)",
        "Archify diagram of the change flow/architecture — like this one"
      ]
    },
    {
      "dot": "emerald",
      "title": "Pilot G1 finding",
      "items": [
        "The gatekeeper blocks even the update of its own feature_list",
        "Recommended improvement: allow state-only commits"
      ]
    }
  ]
}